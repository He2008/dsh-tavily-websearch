{
  "name": "dsh-tavily-websearch",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "description": "Tavily-backed search provider for the DeepSeek Harness web_search tool, with multi-key rotation and a settings card.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/He2008/dsh-tavily-websearch.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tavily",
    "web-search"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
